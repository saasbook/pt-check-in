# Copy to .env for local development. In production (Dokploy) set these as
# environment variables instead; .env is ignored by git.

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials).
# Authorized redirect URI must be <APP_BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: restrict the Google account picker to one Google Workspace domain.
GOOGLE_HOSTED_DOMAIN=berkeley.edu

# Random secret for signing session cookies, at least 64 characters.
# Generate with: ruby -rsecurerandom -e 'puts SecureRandom.hex(64)'
SESSION_SECRET=

# Who may sign in. Users must appear in ALLOWLIST_SOURCE or ALLOWLIST_EMAILS.
# ALLOWLIST_SOURCE is a CSV URL (e.g. a Google Sheet published as CSV) or a local file path.
ALLOWLIST_SOURCE=https://docs.google.com/spreadsheets/d/e/XXXX/pub?output=csv
# Comma-separated emails that are always allowed (useful for bootstrapping).
ALLOWLIST_EMAILS=
# How often (seconds) to re-read ALLOWLIST_SOURCE. Default 300.
ALLOWLIST_TTL_SECONDS=300

# Student roster used to show who was scanned: a CSV URL (e.g. a Google Sheet
# published as CSV) or local file path. Needs a "Student ID" or "SID" column;
# "Email"/"Email Address", "Name"/"Full Name", "First Name" and "Last Name"
# columns are displayed when present. Leave empty to skip the lookup.
ROSTER_SOURCE=
# How often (seconds) to re-read ROSTER_SOURCE. Default 300.
ROSTER_TTL_SECONDS=300

# Public URL of the app. Usually not needed: it is derived from the request.
# Set it if OAuth redirects go to the wrong host/scheme behind a proxy.
#APP_BASE_URL=https://checkin.example.edu

# Server settings
PORT=8080
RACK_ENV=development
