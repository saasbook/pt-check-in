<% @title = "Access denied" %>
<section class="card center">
  <h1>Access denied</h1>
  <% if email %>
    <p><strong><%= email %></strong> is not on the allowed list for this app.</p>
    <p>If you should have access, ask an administrator to add your email address to the allowlist, then sign in again.</p>
  <% else %>
    <p>No verified email address was provided, so you cannot be signed in.</p>
  <% end %>
  <% if settings.dev_login %>
    <p><a href="/login">Sign in with a different email</a></p>
  <% else %>
    <form method="post" action="/auth/google">
      <input type="hidden" name="authenticity_token" value="<%= csrf_token %>">
      <button type="submit" class="primary">Sign in with a different account</button>
    </form>
  <% end %>
</section>
