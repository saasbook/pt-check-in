<% @title = "Scan" %>
<section class="scan" id="scan"
         data-pt-origin="<%= settings.prairietest_origin %>"
         data-pt-id-field="<%= settings.prairietest_id_field %>">
  <p class="status-line">Status: <span id="status">Initializing...</span></p>
  <p class="status-line pt-line">PrairieTest: <span id="pt-status">not connected</span></p>
  <div id="scanner">
    <video id="video" autoplay muted playsinline></video>
    <p>
      <button id="retry" class="primary" hidden>Retry</button>
    </p>
    <form id="manual" class="manual" autocomplete="off">
      <label for="manual-id">Or type an ID</label>
      <input id="manual-id" name="id" inputmode="text" placeholder="Student or staff ID">
      <button type="submit" class="primary small">Look up</button>
    </form>
    <p class="hint">A USB barcode scanner works too: scan while this page is open. You can also paste an ID. Letters in the code are removed automatically.</p>
  </div>
  <div id="result" hidden>
    <div id="barcode-letters" class="letters" hidden></div>
    <div id="barcode-id"></div>
    <div id="barcode-source"></div>
    <div id="student" class="student"></div>
    <p id="pt-sent" class="pt-sent" hidden></p>
    <button id="next" class="primary">Next</button>
  </div>
</section>
<script src="/scanner.js" defer></script>
